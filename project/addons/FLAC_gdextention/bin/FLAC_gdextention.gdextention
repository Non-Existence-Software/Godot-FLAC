[configuration]

entry_symbol = "flac_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

macos.debug = "./macos/FLAC_gdextention.macos.template_debug.framework"
macos.release = "./macos/FLAC_gdextention.macos.template_release.framework"

ios.debug = "./ios/FLAC_gdextention.ios.template_debug.xcframework"
ios.release = "./ios/FLAC_gdextention.ios.template_release.xcframework"

windows.debug.x86_32 = "./windows/FLAC_gdextention.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "./windows/FLAC_gdextention.windows.template_release.x86_32.dll"

windows.debug.x86_64 = "./windows/FLAC_gdextention.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./windows/FLAC_gdextention.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "./linux/FLAC_gdextention.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./linux/FLAC_gdextention.linux.template_release.x86_64.so"

linux.debug.arm64 = "./linux/FLAC_gdextention.linux.template_debug.arm64.so"
linux.release.arm64 = "./linux/FLAC_gdextention.linux.template_release.arm64.so"

linux.debug.rv64 = "./linux/FLAC_gdextention.linux.template_debug.rv64.so"
linux.release.rv64 = "./linux/FLAC_gdextention.linux.template_release.rv64.so"

android.debug.x86_64 = "./android/FLAC_gdextention.android.template_debug.x86_64.so"
android.release.x86_64 = "./android/FLAC_gdextention.android.template_release.x86_64.so"

android.debug.arm64 = "./android/FLAC_gdextention.android.template_debug.arm64.so"
android.release.arm64 = "./android/FLAC_gdextention.android.template_release.arm64.so"